# Futu OpenD Connection Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# HOST CONFIGURATION
# =============================================================================

# Comma-separated OpenD hosts with per-host RSA flag
# Format: host:port:is_rsa (e.g., "127.0.0.1:11111:false,172.18.208.88:11111:true")
# - is_rsa=true means use RSA encryption for this host (remote hosts require RSA)
# - is_rsa=false means plain connection (localhost typically uses false)
# - The connect package TCP-probes all hosts in parallel, fastest wins
# - If a host fails, it automatically tries the opposite RSA mode as fallback
# - If all hosts fail, it retries with exponential backoff (1s→2s→4s→...→60s)
FUTU_OPEND_HOSTS=127.0.0.1:11111:false,172.18.208.88:11111:true,172.20.208.88:11111:true

# Fallback single host (used if FUTU_OPEND_HOSTS is not set)
FUTU_ADDR=127.0.0.1:11111

# =============================================================================
# RSA CONFIGURATION
# =============================================================================

# Path to RSA private key file (for encrypted connections)
# The Go SDK accepts PKIX "PUBLIC KEY", "RSA PRIVATE KEY" (PKCS1),
# or "PRIVATE KEY" (PKCS8) PEM formats.
FUTU_RSA_KEY=/etc/futu/keys/private_key.pem

# =============================================================================
# NETWORK SETTINGS
# =============================================================================

# TCP probe timeout in seconds (default: 3)
# Lower values = faster failover but may miss slow hosts
FUTU_TCP_TIMEOUT=3

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Trading password MD5 hash (required for real trading only, not for simulate)
# Leave empty for simulate trading
FUTU_TRADE_PWD=

# =============================================================================
# WEBSOCKET CONFIGURATION (optional)
# =============================================================================

# WebSocket addresses for alternative connection (comma-separated)
FUTU_WS_ADDR=127.0.0.1:11113

# WebSocket secret key (if required by your OpenD setup)
FUTU_WS_SECRET=